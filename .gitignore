# Dependencies
node_modules/

# Build and package output
release/
dist/
out/
build/
*.zip
*.7z

# Generated validation and benchmark artifacts
artifacts/
**/target/

# Vendored media toolchain. These are build inputs, not source, and the ffmpeg
# "full" build alone is over 200 MB -- past GitHub's per-file limit. The
# portable build script expects bin\ffmpeg.exe (the full build, for libplacebo)
# and bin\ffprobe.exe to be placed here before packaging.
bin/

# Runtime and test logs
*.log
*.err
*.tmp
*.temp

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local caches and databases
cache/
*.sqlite
*.sqlite3
*.db

